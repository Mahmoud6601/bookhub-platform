# BookHub — environment variables for Docker Compose.
# Copy this file to .env (in the REPO ROOT, next to docker-compose.yml):
#   cp .env.example .env
# Then fill in the three REQUIRED secrets. .env is gitignored — NEVER commit it.
# Values here are used ONLY by Compose for ${...} interpolation; the Laravel
# app reads its own api/.env inside the container (see README.md).

# --- REQUIRED: the stack refuses to start without these -------------------
# Database password for the `app` user (also used by the API).
DB_PASSWORD=
# Root password for MySQL (used by the db healthcheck and backups).
MYSQL_ROOT_PASSWORD=
# Laravel application key. Generate one with:
#   cd api && composer install && php artisan key:generate --show
# and paste the full "base64:..." value here.
APP_KEY=

# --- Optional (defaults shown) -------------------------------------------
DB_DATABASE=bookapi
DB_USERNAME=app
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
# Hostname used as Nginx server_name (rendered into the config template).
APP_URL_HOST=localhost
# Comma-separated CORS origins allowed by the API.
CORS_ALLOWED_ORIGINS=https://localhost,http://localhost:3000
# Browser-facing API base URL used by the Nuxt client (empty = same-origin /api via Nginx;
# set to http://localhost:8000 if accessing client directly on :3000).
NUXT_PUBLIC_API_BASE=
# Image tag for local builds / prod deploys (CI sets this to the git SHA).
IMAGE_TAG=dev
# Docker Hub username (only needed for docker-compose.prod.yml).
DOCKER_USERNAME=
