# BookHub Nginx — server blocks (template).
# Rendered by the official nginx image's envsubst entrypoint from the
# APP_URL_HOST environment variable (set in docker-compose.yml).
# NOTE: only ${APP_URL_HOST} is substituted — $host, $remote_addr and the
# other Nginx variables are NOT environment variables, so envsubst leaves
# them untouched.
#
# - Port 80: /healthz answers 200 for the container healthcheck, everything
#   else redirects to HTTPS.
# - Port 443: TLS termination, security headers, proxies / to the Nuxt
#   client (:3000) and /api to the Laravel API (:8000).

server {
    listen 80;
    server_name ${APP_URL_HOST};

    # Health endpoint for the container healthcheck (plain HTTP, no redirect).
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }

    error_page 502 /502.html;
    location = /502.html {
        internal;
        default_type text/html;
        return 502 "<!doctype html><html><head><title>502 Bad Gateway</title></head><body><h1>502 Bad Gateway</h1><p>BookHub upstream service is temporarily unavailable.</p></body></html>";
    }
}

server {
    listen 443 ssl;
    server_name ${APP_URL_HOST};

    ssl_certificate /etc/nginx/ssl/nginx-selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx-selfsigned.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:8000;" always;

    # Health endpoint (also reachable over HTTPS).
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://client:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location /api {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    error_page 502 /502.html;
    location = /502.html {
        internal;
        default_type text/html;
        return 502 "<!doctype html><html><head><title>502 Bad Gateway</title></head><body><h1>502 Bad Gateway</h1><p>BookHub upstream service is temporarily unavailable.</p></body></html>";
    }
}
